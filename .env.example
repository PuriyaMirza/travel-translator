# Server-side only. Read by src/lib/translate.ts; never bundled into the
# client (SPEC.md §2 rule 6). Set this in Vercel project settings, not here —
# this file documents which vars exist and never holds a real value.
ANTHROPIC_API_KEY=

# Only needed when ANTHROPIC_API_KEY is an identity-linked key. Those must
# name the workspace each request acts in, and the API rejects the request
# with a 400 if the header is missing. Leave this unset for a plain API key —
# translate.ts omits the header entirely when it is empty.
ANTHROPIC_WORKSPACE_ID=
