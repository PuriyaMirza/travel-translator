# Server-side only. Read by src/lib/translate.ts; never bundled into the
# client (SPEC.md §2 rule 6). Set this in Vercel project settings, not here —
# this file documents which vars exist and never holds a real value.
ANTHROPIC_API_KEY=

# Prefer a WORKSPACE-SCOPED key above and leave this unset — that is the
# configuration this app is verified against.
#
# Only needed if the key is identity-scoped instead. Those must name the
# workspace each request acts in, and the API rejects the request with a 400
# ("anthropic-workspace-id is required...") if the header is missing.
# translate.ts omits the header entirely when this is empty.
ANTHROPIC_WORKSPACE_ID=

# Firebase web app config (M3: accounts and vault). Public identifiers, not
# secrets — Firebase's web "API key" only names the project; firestore.rules
# is what protects user data. Copy them from Firebase console → Project
# settings → Your apps → Web app. Leave all four empty and the app still
# works, with saved phrases kept on the device only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local only — never set in Vercel. "1" points auth and Firestore at the
# Firebase emulators on 127.0.0.1:9099 / :8080.
NEXT_PUBLIC_FIREBASE_EMULATORS=
