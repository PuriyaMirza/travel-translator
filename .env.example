# Server-side only. Read by src/lib/translate.ts; never bundled into the
# client (SPEC.md §2 rule 6). Set this in Vercel project settings, not here —
# this file documents which vars exist and never holds a real value.
ANTHROPIC_API_KEY=

# Prefer a WORKSPACE-SCOPED key above and leave this unset — that is the
# configuration this app is verified against.
#
# Only needed if the key is identity-scoped instead. Those must name the
# workspace each request acts in, and the API rejects the request with a 400
# ("anthropic-workspace-id is required...") if the header is missing.
# translate.ts omits the header entirely when this is empty.
ANTHROPIC_WORKSPACE_ID=
